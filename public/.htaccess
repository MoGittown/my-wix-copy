# Hostinger / Apache / LiteSpeed – SPA Routing für React Router (BrowserRouter)
# Mit korrekten Redirects (HTTPS + apex domain) und echtem 404-Status
#
# Wichtig: DirectorySlash Off verhindert den 301 von /referenzen → /referenzen/
# (sonst greift das Verzeichnis dist/referenzen/ ohne index und liefert 403).
# Rewrite-Reihenfolge: .html vor Verzeichnissen, dann index.html in Verzeichnissen.

DirectorySlash Off
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # HTTPS erzwingen
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → apex (non-www) Redirect
  RewriteCond %{HTTP_HOST} ^www\.vollmer-objektmoebel\.com$ [NC]
  RewriteRule ^(.*)$ https://vollmer-objektmoebel.com/$1 [L,R=301]

  # Bereits existierende Dateien (z. B. assets, .html) direkt ausliefern
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # /referenzen → referenzen.html (vor Verzeichnis-Handling)
  # Trailing Slash entfernen, damit .html-Lookup greift
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteCond %{DOCUMENT_ROOT}%1.html -f
  RewriteRule ^(.+)/$ $1.html [L]

  # Bekannte prerenderte Routen ohne Slash → zur entsprechenden .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # /referenzen/ → referenzen/index.html (DirectorySlash ist aus)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*?)/?$ $1/index.html [L]

  # Sonst: 404.html mit HTTP 404 Status
  RewriteRule ^ 404.html [L,R=404]
</IfModule>

# 404 ErrorDocument
ErrorDocument 404 /404.html

# Caching für statische Assets (Bilder, JS, CSS, Fonts)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Gzip/Deflate Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
